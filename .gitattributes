# Normalize line endings in the repository.
#
# Set at scaffold time. Without it a Windows checkout can rewrite whole files to
# CRLF and every line reads as changed — which in this portfolio has already
# buried a real one-line change inside a 6,850-line phantom diff.

* text=auto eol=lf

# Binary — never touched.
*.png  binary
*.jpg  binary
*.webp binary
*.mp3  binary
*.ogg  binary
*.wav  binary
