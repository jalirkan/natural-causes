{
  "name": "natural-causes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A horde-survival roguelike where the progression is a human life",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "art:generate": "tsx tools/art/generate.ts",
    "art:conform": "tsx tools/art/conform.ts",
    "art:pack": "tsx tools/art/pack.ts",
    "playtest": "tsx tools/playtest/run.ts"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "sharp": "^0.34.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
